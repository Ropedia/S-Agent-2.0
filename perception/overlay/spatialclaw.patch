diff --git a/spatial_agent/gpu_models/types.py b/spatial_agent/gpu_models/types.py
index b2200be..2a627c4 100644
--- a/spatial_agent/gpu_models/types.py
+++ b/spatial_agent/gpu_models/types.py
@@ -194,3 +194,20 @@ class SAM3VideoSegmentationOutput(AgentContext):
     def to_message_content(self) -> str:
         n_obj = len(self.object_ids) if self.object_ids else 0
         return f"SAM3 tracked {n_obj} object(s) across {self.num_frames} frames"
+
+
+@dataclass
+class Pi3MosDynamicOutput(AgentContext):
+    """Pi3MOS per-pixel motion probability. All arrays are numpy.
+
+    ``dynamic_prob`` lives on the model's own grid (whole-frame LANCZOS
+    resize to a multiple-of-14 size under the pixel budget — no aspect
+    crop), so mapping back to the original frame is a pure resize.
+    """
+    dynamic_prob: Any = None    # np.ndarray (N, h, w) float16 in [0, 1]
+    frame_indices: List[int] = None
+    num_frames: int = 0
+    input_size: List[int] = None  # [width, height] of the model grid
+
+    def to_message_content(self) -> str:
+        return f"Pi3MOS motion probability for {self.num_frames} frames"
