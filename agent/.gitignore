# --- Generated task directories ---------------------------------------------
# `datasets/` and `tasks/` are emitted by adapters/*/run_adapter.py: 400 ERQA
# task dirs where Dockerfile, score_erqa.py and test.sh are byte-identical
# copies and each perception.py differs only in one hardcoded absolute path.
# Regenerate rather than clone them:
#   python3 adapters/erqa_spatial/run_adapter.py --output-dir datasets/erqa_spatial
datasets/
tasks/

# --- Run outputs and scratch space ------------------------------------------
# work/ holds extracted benchmark frames and perception artifacts, ~5 GB.
# (No trailing comments on pattern lines: gitignore treats them as part of the
# path, which silently disables the rule.)
work/
logs/
runs/
*.npy
*.png
*.jpg

# --- Virtualenvs and tool caches ---------------------------------------------
# (uv writes a self-ignoring .gitignore into these, but be explicit so the
# intent survives a `uv cache clean`)
.venv*/
.uv-cache/
.ruff_cache/
.pytest_cache/
__pycache__/
*.pyc

# --- Probe and debug artifacts ----------------------------------------------
# One-off diagnostics. debug/bin/docker is a deliberately kept tracing wrapper;
# its output is not.
.permprobe/
debug/*.log

# --- Agent session transcripts ----------------------------------------------
# Claude Code writes these on export; they are conversation logs, not source.
20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]-*.txt

# --- Secrets ------------------------------------------------------------------
.env
.env.*
*.pem
gpu_server.json

